# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cpo_ocpi
DB_USER=cpo_user
DB_PASSWORD=cpo_password
DB_DIALECT=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=development

# OCPI Configuration
OCPI_VERSION=2.2
OCPI_BASE_URL=https://api.cpo-example.com
OCPI_PARTY_ID=IPD
OCPI_COUNTRY_CODE=ES
OCPI_TOKEN=escribe_aqui_un_token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DISABLE_RATE_LIMIT=false

# EVSE Notification Service
EVSE_NOTIFICATION_INTERVAL_MS=30000

# EMSP Locations Sync Service
EMSP_LOCATIONS_SYNC_INTERVAL_MS=60000

# EMSP Tariffs Sync Service
EMSP_TARIFFS_SYNC_INTERVAL_MS=60000

# EMSP Tokens Sync Service
EMSP_TOKENS_SYNC_INTERVAL_MS=60000

# Test Location EVSE Creation Service
TEST_LOCATION_EVSE_CREATION_INTERVAL_MS=300000

TEST_SESSION_INTERVAL_MS=60000
TEST_SESSION_DURATION_MS=30000




